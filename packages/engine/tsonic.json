{
  "$schema": "https://tsonic.org/schema/v1.json",
  "entryPoint": "index.ts",
  "rootDir": "src",
  "outDir": "out",
  "targets": [
    {
      "id": "rust",
      "surfaces": ["js"],
      "options": {
        "crateName": "tsumo_engine",
        "edition": "2024",
        "outputType": "lib",
        "projectFile": "Cargo.toml"
      }
    }
  ]
}
